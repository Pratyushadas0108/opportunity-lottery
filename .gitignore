# Virtual Environment
.venv/
env/
venv/
ENV/

# Python / Jupyter artifacts
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.nbconvert/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Raw data files (kept locally, documented via raw_data/README.md)
raw_data/*
!raw_data/.gitkeep
!raw_data/README.md

# Large files / Binary files (GitHub file limit is 100MB, warning at 50MB)
# Note: Power BI files (.pbix) can become very large when data models are cached.
# If dashboard/*.pbix exceeds 50MB, uncomment the line below:
# dashboard/*.pbix

# Secrets and environment variables
.env

# Matplotlib cache
dashboard/charts/.mpl_cache/

# Private study files (kept local, untracked)
interview_notes.txt
